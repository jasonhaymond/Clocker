generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  jobs         Job[]
  shifts       Shift[]
  managers     Manager[]
}

// A saved recipient for the "export to email" flow — a name + email address, so sending
// a timesheet is "pick who" instead of retyping an address every time.
model Manager {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  jobManagers JobManager[]

  @@index([userId, updatedAt])
}

model Job {
  id                          String     @id @default(uuid())
  userId                      String
  user                        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                        String
  colorHex                    String     @default("#2563eb")
  archived                    Boolean    @default(false)
  // Overtime is calculated per ISO week (Mon-Sun) across all of this job's shifts that
  // week. Null multiplier/threshold means overtime is disabled for this job. See
  // docs/sync-protocol.md and app/src/lib/pay.ts for the exact allocation rule.
  overtimeMultiplier          Float?
  overtimeWeeklyThresholdHours Float?
  // Timesheet tab settings — each job has its own recurring pay period and its own
  // submission preferences, since different jobs can legitimately pay on different
  // schedules and report to different people. See app/src/lib/timesheetPeriods.ts.
  timesheetPeriodType         String     @default("weekly") // "weekly" | "biweekly" | "monthly"
  timesheetWeekStartDay       Int        @default(1) // 0=Sun..6=Sat
  timesheetBiweeklyAnchor     DateTime   @default(now())
  timesheetMonthlyStartDay    Int        @default(1) // 1-28
  timesheetFormat             String     @default("both") // "csv" | "text" | "both"
  timesheetIncludeEarnings    Boolean    @default(true)
  timesheetIncludeNotes       Boolean    @default(true)
  timesheetIncludeTimes       Boolean    @default(true)
  // Time entry rounding — optional, per job. Rounds each shift's clock-in/out to the
  // nearest increment before computing worked hours/pay (like a physical timeclock);
  // the stored punch times themselves are never altered. See app/src/lib/rounding.ts.
  roundingEnabled              Boolean    @default(false)
  roundingMode                 String     @default("nearest") // "up" | "down" | "nearest"
  roundingIncrementMinutes     Int        @default(15)
  // Per-job: whether clocking out of this job prompts for an optional note. Used to be a
  // single device-local preference covering every job; moved here since different jobs
  // legitimately want different behavior (e.g. always add a note for client billing on
  // one job, never bothered for another) — see app/src/lib/preferences.ts's old comment.
  promptForNotesOnClockOut    Boolean    @default(false)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  deletedAt                   DateTime?
  shifts                      Shift[]
  rateTiers                   RateTier[]
  jobManagers                 JobManager[]

  @@index([userId, updatedAt])
}

// Assigns a Manager as a submission recipient for a specific job's timesheets. A plain
// join row (no extra fields of its own) rather than a field on either side, since it's a
// many-to-many: one manager can receive timesheets for several jobs, and a job can submit
// to several managers.
model JobManager {
  id        String    @id @default(uuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  managerId String
  manager   Manager   @relation(fields: [managerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([jobId, updatedAt])
  @@index([managerId])
}

// A named rate under a job (most jobs have exactly one, called "Standard"). Exists so a
// job can have more than one rate (e.g. "Standard" vs "Holiday") and so a shift can record
// which one it was worked under.
model RateTier {
  id         String        @id @default(uuid())
  jobId      String
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name       String
  isDefault  Boolean       @default(false)
  archived   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  versions   RateVersion[]
  shifts     Shift[]

  @@index([jobId, updatedAt])
}

// A rate tier's value, effective from a point in time. Changing a tier's rate creates a
// new version rather than editing the old one, so a past shift's pay is always computed
// from the version that was active when it happened, not whatever the rate is today.
model RateVersion {
  id              String    @id @default(uuid())
  tierId          String
  tier            RateTier  @relation(fields: [tierId], references: [id], onDelete: Cascade)
  hourlyRateCents Int
  effectiveFrom   DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([tierId, effectiveFrom])
}

model Shift {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Which of the job's rate tiers this shift was worked under. Null means "the job's
  // default tier at export time" rather than freezing in a specific tier id, so a shift
  // clocked before any tiers existed still resolves sensibly.
  rateTierId String?
  rateTier   RateTier?  @relation(fields: [rateTierId], references: [id], onDelete: SetNull)
  clockIn    DateTime
  clockOut   DateTime?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  breaks     Break[]

  @@index([userId, updatedAt])
  @@index([jobId])
  @@index([rateTierId])
}

model Break {
  id        String    @id @default(uuid())
  shiftId   String
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shiftId, updatedAt])
}
