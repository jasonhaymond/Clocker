# `npm run setup` generates server/.env for you automatically, scanning for free ports
# starting at 5433 (Postgres) and 3001 (this API) rather than assuming those are free on
# your machine — see scripts/setup.mjs. This file is only a reference for setting one up
# by hand; the values below are just illustrative defaults, not guaranteed-free ports.
DATABASE_URL="postgresql://clocker:clocker@localhost:5433/clocker?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001

# Optional comma-separated allowlist of origins allowed to make cross-origin browser
# requests (e.g. "https://clocker.example.com"). Only matters for a browser on some
# *other* origin than the API itself — the mobile app and any non-browser client are
# unaffected either way. Left unset here for local dev: the server then falls back to
# allowing any http://localhost:<port> or http://127.0.0.1:<port> origin, which is what
# lets `web`'s Vite dev server (a different port than this API) reach it. The production
# Compose files set this automatically to `https://$DOMAIN`.
