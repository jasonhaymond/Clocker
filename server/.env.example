# `npm run setup` generates server/.env for you automatically, scanning for free ports
# starting at 5433 (Postgres) and 3001 (this API) rather than assuming those are free on
# your machine — see scripts/setup.mjs. This file is only a reference for setting one up
# by hand; the values below are just illustrative defaults, not guaranteed-free ports.
DATABASE_URL="postgresql://clocker:clocker@localhost:5433/clocker?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001
