# `npm run setup` generates server/.env for you automatically, scanning for free ports
# starting at 5433 (Postgres) and 3001 (this API) rather than assuming those are free on
# your machine — see scripts/setup.mjs. This file is only a reference for setting one up
# by hand; the values below are just illustrative defaults, not guaranteed-free ports.
# For production (.env.prod, not this file), `npm run configure` sets REGISTRATION_ENABLED
# and SMTP_* below interactively instead of hand-editing.
DATABASE_URL="postgresql://clocker:clocker@localhost:5433/clocker?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001

# Optional comma-separated allowlist of origins allowed to make cross-origin browser
# requests (e.g. "https://clocker.example.com"). Only matters for a browser on some
# *other* origin than the API itself — the mobile app and any non-browser client are
# unaffected either way. Left unset here for local dev: the server then falls back to
# allowing any http://localhost:<port> or http://127.0.0.1:<port> origin, which is what
# lets `web`'s Vite dev server (a different port than this API) reach it. The production
# Compose files set this automatically to `https://$DOMAIN`.

# The server's own externally-reachable URL, used to build absolute links: a generated
# invoice's "view online" page, and a password-reset email's link. Left unset here for
# local dev: falls back to reconstructing it from the incoming request's own
# protocol/host, which is fine until you're behind a reverse proxy that changes those.
# The production Compose files set this automatically to `https://$DOMAIN`.
PUBLIC_URL=

# Set to "false" to close self-registration once your intended users have signed up —
# /auth/register then refuses new accounts with a clear error, existing accounts are
# unaffected. Any other value (or leaving this unset) keeps registration open. Doesn't
# replace the CAPTCHA/rate limiting already on that route; this is for a deployment
# meant for a fixed, known group of people rather than the general public.
REGISTRATION_ENABLED=

# SMTP credentials for the one thing this server ever emails on its own: password reset
# links (everything else — timesheet submission, invoice delivery — hands off to the
# device's own mail app instead, since those always have a signed-in user with a mail
# client; a forgotten password has neither). Optional: leave every SMTP_* var unset and
# /auth/forgot-password just reports the feature isn't configured, rather than failing to
# start — a server that forgot to set these up doesn't break anything else. A locked-out
# user can still be helped by whoever runs the server resetting their password directly
# in the database in the meantime.
#
# Any real SMTP provider works — your own mail server, or a transactional-email service
# (Postmark, SES, Mailgun, etc.) used in plain SMTP mode. SMTP_FROM must be an address
# your provider is actually allowed to send as (most providers reject anything else).
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (typically port 465); leave unset/false for STARTTLS (587) or
# no encryption (25) — the far more common setup with most providers.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Clocker <noreply@your-domain.com>"
