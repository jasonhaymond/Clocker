{
	# Uncomment to get ACME certificate/renewal logs while first setting this up:
	# debug
}

# Set DOMAIN to your real hostname in .env.prod before deploying (see docs/deployment.md).
# Defaults to localhost so `docker compose -f docker-compose.prod.yml up` also works
# untouched for a quick local smoke test (Caddy uses its internal CA for localhost,
# not a real Let's Encrypt certificate).
{$DOMAIN:localhost} {
	reverse_proxy server:3001

	encode gzip

	log {
		output stdout
		format console
	}
}

# The web client (see docs/deployment.md#deploying-the-web-client) — only reachable if
# you also start the `web` service (`docker compose --profile web up -d`). Defaults to
# `web.localhost`, distinct from DOMAIN's own `localhost` default above, so the two site
# blocks never collide before either is configured with a real hostname. Routing here
# still works even if the `web` service isn't running — this block just 502s for
# WEB_DOMAIN's hostname until it is, without affecting the API's own site block above.
{$WEB_DOMAIN:web.localhost} {
	reverse_proxy web:80

	encode gzip

	log {
		output stdout
		format console
	}
}
