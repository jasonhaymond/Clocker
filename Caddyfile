{
	# Uncomment to get ACME certificate/renewal logs while first setting this up:
	# debug
}

# Set DOMAIN to your real hostname in .env.prod before deploying (see docs/deployment.md).
# Defaults to localhost so `docker compose -f docker-compose.prod.yml up` also works
# untouched for a quick local smoke test (Caddy uses its internal CA for localhost,
# not a real Let's Encrypt certificate).
#
# One domain, two upstreams: the API's own fixed set of routes (/health, /auth/*,
# /sync/*, see server/src/index.ts and server/src/routes/*.ts) goes to `server`;
# everything else — the web client's app shell and static assets — goes to `web`. This is
# what "same domain" means here: the mobile app's EXPO_PUBLIC_API_URL and a browser
# visiting this domain hit the same host, just different paths.
{$DOMAIN:localhost} {
	handle /health {
		reverse_proxy server:3001
	}
	handle /auth/* {
		reverse_proxy server:3001
	}
	handle /sync/* {
		reverse_proxy server:3001
	}
	handle {
		reverse_proxy web:80
	}

	encode gzip

	log {
		output stdout
		format console
	}
}
