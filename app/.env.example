# Copy to app/.env and set to your server's URL. Expo loads this automatically (no
# extra config needed — @expo/env is built in) for `npx expo start` and EAS builds alike;
# any var prefixed EXPO_PUBLIC_ gets inlined into the app bundle.
#
# Local dev server (default if this file/variable is absent): http://localhost:3001
# Android emulator reaching your own machine: http://10.0.2.2:3001
# A deployed server: https://your-domain.com (see docs/deployment.md)
EXPO_PUBLIC_API_URL=http://localhost:3001
