# Copy to app/.env and set to your server's URL. Expo loads this automatically (no
# extra config needed — @expo/env is built in) for `npx expo start` and EAS builds alike;
# any var prefixed EXPO_PUBLIC_ gets inlined into the app bundle.
#
# Local dev server (default if this file/variable is absent): http://localhost:3001
# Android emulator reaching your own machine: http://10.0.2.2:3001
# A deployed server: https://your-domain.com (see docs/deployment.md)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Only needed for the job-location map picker's Android build (iOS uses Apple Maps for
# free, no key needed). Not prefixed EXPO_PUBLIC_ — it's read by app.config.js at
# build/config time, not inlined into the JS bundle. Get one from the Google Cloud
# Console (enable "Maps SDK for Android", restrict it to this app's package name + SHA-1
# fingerprint). Leave unset to develop without it — "Use My Current Location" still works.
ANDROID_GOOGLE_MAPS_API_KEY=

# Links EAS builds to a specific EAS project. Not prefixed EXPO_PUBLIC_ — read by
# app.config.js at build/config time only, same as the Maps key above. Leave unset for
# local dev (only `eas build`/`eas update` need it). The very first `eas build` or
# `eas build:configure` against a fresh EAS account prints the project ID to use here —
# paste it in once and every build after that resolves the project with no more prompts.
EAS_PROJECT_ID=
