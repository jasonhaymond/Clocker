# `npm run deploy -- your-domain.com` generates .env.prod for you automatically —
# POSTGRES_PASSWORD and JWT_SECRET are random-generated and persisted, and DOMAIN is
# filled in from the argument you pass (see scripts/deploy.mjs). This file is only a
# reference for setting one up by hand if you'd rather not use that script; the values
# below are illustrative, not real defaults.
#
# Manual usage: cp .env.prod.example .env.prod, fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# A strong password for the production Postgres container (not the local dev one).
POSTGRES_PASSWORD=

# A long random string — generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your server's real hostname, e.g. clocker.example.com.
# - PROXY_MODE=local (default): must have a DNS A/AAAA record pointing at this machine's
#   public IP before starting, so the bundled Caddy can get a Let's Encrypt certificate
#   for it. Ports 80 and 443 must be reachable from the internet.
# - PROXY_MODE=external: used only to label the printed Caddy site-block snippet — your
#   own external proxy is what actually needs DNS/certificates configured for it.
DOMAIN=

# --- Only used if you also deploy the web client (PROXY_MODE=local) — see
# docs/deployment.md#deploying-the-web-client. Not wired into `npm run deploy`; a manual
# `docker compose --profile web up -d --build` step. ---

# The web client's own hostname, e.g. app.example.com — needs its own DNS A/AAAA record
# the same way DOMAIN does. Defaults to web.localhost (untouched) if you don't set this
# and never run the `web` profile.
WEB_DOMAIN=

# --- Only used with PROXY_MODE=external (npm run deploy -- your-domain.com --external-proxy) ---
# See docs/deployment.md#deploying-behind-your-own-reverse-proxy.

# "local" (default, omit this line) runs the bundled Caddy and owns ports 80/443 itself.
# "external" skips it and instead publishes the server's own port, for your own reverse
# proxy (a separate Caddy/nginx/Traefik, possibly on a different machine) to reach.
PROXY_MODE=local

# Host port the server is published on when PROXY_MODE=external. Auto-picked (starting
# at 3001, scanning for one that's actually free) by `npm run deploy` — you shouldn't
# normally need to set this by hand.
SERVER_PORT=3001

# Interface the server's port is published on when PROXY_MODE=external. Defaults to all
# interfaces (0.0.0.0) since an external proxy — possibly on a different machine — needs
# to reach it; lock this down with a firewall rule scoped to your proxy's IP, or set this
# to a specific private/internal IP if this host has one only your proxy can reach.
SERVER_BIND=0.0.0.0
