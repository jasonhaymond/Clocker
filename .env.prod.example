# Copy to .env.prod and fill in real values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# A strong password for the production Postgres container (not the local dev one).
POSTGRES_PASSWORD=

# A long random string — generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your server's real hostname, e.g. clocker.example.com — must have a DNS A/AAAA record
# pointing at this machine's public IP before starting, so Caddy can get a Let's Encrypt
# certificate for it. Ports 80 and 443 must be reachable from the internet.
DOMAIN=
