# Read by Docker Compose (not the app) for docker-compose.yml's port mapping.
# `npm run setup` generates this automatically, scanning for a free port starting at 5433
# rather than assuming it's free on your machine — see scripts/setup.mjs. Only needed if
# you're running `docker compose up` directly without going through setup and 5433 is
# already taken by something else.
POSTGRES_PORT=5433
